{
  "include": [
    "backend",
    "api"
  ],
  "extraPaths": [
    "backend",
    "."
  ],
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": [
        ".",
        "backend"
      ]
    },
    {
      "root": "api",
      "extraPaths": [
        "../backend",
        "backend"
      ]
    }
  ],
  "reportGeneralTypeIssues": "warning",
  "typeCheckingMode": "basic"
}
